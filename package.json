{
  "name": "giftful-mcp",
  "version": "0.2.0",
  "description": "A local MCP server for managing Giftful lists, friends, and wishes",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matt-pulsipher/giftful-mcp.git"
  },
  "homepage": "https://github.com/matt-pulsipher/giftful-mcp#readme",
  "bugs": {
    "url": "https://github.com/matt-pulsipher/giftful-mcp/issues"
  },
  "keywords": [
    "giftful",
    "mcp",
    "model-context-protocol",
    "wishlist"
  ],
  "bin": {
    "giftful-mcp": "dist/index.js",
    "giftful-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/cli.ts",
    "test": "tsx --test test/**/*.test.ts",
    "check:live-schema": "npm run build && node scripts/validate-live-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "playwright-core": "^1.62.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
