# Optional profile name, useful for multiple Giftful accounts.
GIFTFUL_PROFILE=default

# auto (default) uses the OS credential vault: macOS Keychain, Windows Credential
# Manager, or Secret Service on Linux. Use file only when no vault is available.
# GIFTFUL_AUTH_STORAGE=auto

# Optional override for file storage. Do not place this inside a Git repository.
# GIFTFUL_AUTH_FILE=/absolute/path/to/giftful-auth.json

# Optional browser executable and timeout for browser-based authentication.
# GIFTFUL_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# GIFTFUL_BROWSER_LOGIN_TIMEOUT_MS=600000

# API overrides exist for testing and future migrations.
# GIFTFUL_GRAPHQL_URL=https://api.giftful.com/graphql
# GIFTFUL_LINK_URL=https://link.giftful.com
